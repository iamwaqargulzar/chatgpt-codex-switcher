{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexDesk",
  "version": "0.1.2",
  "identifier": "dev.codexdesk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexDesk",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      },
      {
        "label": "tray-popup",
        "title": "CodexDesk",
        "url": "tray.html",
        "width": 380,
        "height": 560,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "ChatGPT Codex CLI account manager & switcher",
    "longDescription": "CodexDesk manages multiple ChatGPT Codex CLI accounts on Linux: one-click switching, live rate-limit and reset timers, usage stats, warm-ups, profiles and sessions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
